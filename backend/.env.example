# LiveKit Cloud project credentials (required for /api/session and the agent worker)
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# REST API bind address (default 127.0.0.1:8500; 8000 is often reserved on Windows)
API_HOST=127.0.0.1
API_PORT=8500

# Comma-separated CORS allow-list for the frontend (add the Vercel production URL when hosted)
FRONTEND_ORIGINS=http://localhost:3000
# Optional regex for extra CORS origins, e.g. Vercel preview deploys: https://.*\.vercel\.app
FRONTEND_ORIGIN_REGEX=

# Explicit agent dispatch name (must match between API tokens and the worker)
AGENT_NAME=synthio-presenter

# LiveKit Inference model ids (always the last provider in each failover chain)
STT_MODEL=deepgram/nova-3
LLM_MODEL=google/gemini-2.5-flash
TTS_MODEL=cartesia/sonic-3
# Optional TTS voice id; leave empty for the provider default
TTS_VOICE=

# Optional own provider keys. When set, that component tries the provider directly first and
# fails over to LiveKit Inference at runtime (e.g. on a 429 or spent quota). Leave empty to use
# LiveKit Inference only.
# Deepgram: speech-to-text and text-to-speech. Get a key at https://console.deepgram.com/signup
# (then Project -> API Keys).
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Google Gemini API: the LLM. Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_LLM_MODEL=gemini-3.5-flash
# Tried in order after GOOGLE_LLM_MODEL (free-tier quotas are per model)
GOOGLE_LLM_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite-preview
# Gemini 3+ thinking level: minimal (default, lowest voice latency) | low | medium | high.
# Leave empty for the model default.
GOOGLE_THINKING_LEVEL=minimal

# How often the API dispatches a warm-up job to the hosted agent (seconds, 0 = off)
AGENT_WARMUP_INTERVAL_S=3600
