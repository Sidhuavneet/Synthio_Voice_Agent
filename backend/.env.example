# LiveKit Cloud project credentials (required for /api/session and the agent worker)
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# REST API bind address (default 127.0.0.1:8500; 8000 is often reserved on Windows)
API_HOST=127.0.0.1
API_PORT=8500

# Comma-separated CORS allow-list for the frontend
FRONTEND_ORIGINS=http://localhost:3000

# Explicit agent dispatch name (must match between API tokens and the worker)
AGENT_NAME=synthio-presenter

# LiveKit Inference model ids
STT_MODEL=deepgram/nova-3
LLM_MODEL=google/gemini-2.5-flash
TTS_MODEL=cartesia/sonic-3
# Optional TTS voice id; leave empty for the provider default
TTS_VOICE=

# Optional own provider keys. When set, that component calls the provider directly instead of
# LiveKit Inference (useful when the LiveKit Inference quota is spent). Leave empty otherwise.
# Deepgram: speech-to-text and text-to-speech
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Google Gemini API: the LLM
GOOGLE_API_KEY=
GOOGLE_LLM_MODEL=gemini-2.5-flash
