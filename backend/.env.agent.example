# Secrets for the agent on LiveKit Cloud. Copy to .env.agent.local (gitignored), fill in, then:
#   lk agent create --secrets-file .env.agent.local --ignore-empty-secrets
#   lk agent update-secrets --secrets-file .env.agent.local --ignore-empty-secrets   (later changes)
#
# Do NOT add LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET: LiveKit Cloud injects them and
# they cannot be set as secrets. Every value below is optional; with all of them empty the agent
# uses LiveKit Inference only (defaults in src/synthio_backend/core/config.py).
# Blank lines are skipped thanks to --ignore-empty-secrets.

# Own provider keys: tried first, LiveKit Inference is the runtime fallback.
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=

# Model overrides (leave empty for the defaults)
GOOGLE_LLM_MODEL=
# Tried in order after GOOGLE_LLM_MODEL (free-tier quotas are per model)
GOOGLE_LLM_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite-preview
GOOGLE_THINKING_LEVEL=
DEEPGRAM_STT_MODEL=
DEEPGRAM_TTS_MODEL=
STT_MODEL=
LLM_MODEL=
TTS_MODEL=
TTS_VOICE=

# Explicit dispatch name. Must equal the API's AGENT_NAME on Render (both default to
# synthio-presenter), so leave empty unless you change it on both sides.
AGENT_NAME=

# Keeps the free Render API awake while the agent runs (pinged every SELF_PING_INTERVAL_S)
SELF_PING_URL=https://synthio-api.onrender.com/api/health
